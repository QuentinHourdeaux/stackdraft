{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "noUncheckedIndexedAccess": true,
    "strict": true
  },
  "imports": {
    "@oak/oak": "jsr:@oak/oak@17.2.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.6",
    "effect": "npm:effect@3.16.7"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "build": "deno run -A npm:vite@8.1.3 build --config frontend/vite.config.ts",
    "check": "deno check api/main.ts frontend/src/main.tsx frontend/vite.config.ts tests/health_test.ts tests/http_app_test.ts tests/migrations_test.ts",
    "ci": "deno fmt --check && deno lint && deno task check && deno task test && deno task build",
    "dev": "deno run -A npm:concurrently@9.2.1 --kill-others-on-fail --names api,web \"deno task dev:api\" \"deno task dev:web\"",
    "dev:api": "deno run --watch=api,migrations --allow-env --allow-net --allow-read --allow-write api/main.ts",
    "dev:web": "deno run -A npm:vite@8.1.3 --config frontend/vite.config.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "start": "deno run --allow-env --allow-net --allow-read --allow-write api/main.ts",
    "test": "deno test --allow-env --allow-read --allow-write tests"
  }
}
